{
  "manifest_version": 3,
  "name": "Cookie Crunch Blocker",
  "version": "9.9",
  "permissions": ["storage", "scripting", "declarativeNetRequest", "webNavigation", "tabs", "alarms", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "Cookie Crunch Blocker" },
  "side_panel": { "default_path": "popup.html" },
  "background": { "service_worker": "background.js" },
  "declarative_net_request": {
    "rule_resources": [{
      "id": "ruleset_1",
      "enabled": true,
      "path": "rules.json"
    }]
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "exclude_matches": [
      "*://*.youtube.com/*", "*://youtube.com/*", "*://*.youtu.be/*", "*://youtu.be/*",
      "*://*.google.com/*", "*://google.com/*",
      "*://*.google.co.uk/*", "*://google.co.uk/*",
      "*://*.google.com.au/*", "*://google.com.au/*",
      "*://*.google.ca/*", "*://google.ca/*",
      "*://*.google.de/*", "*://google.de/*",
      "*://*.google.fr/*", "*://google.fr/*"
    ],
    "css": ["blocker.css"],
    "js": ["content_isolated.js"],
    "run_at": "document_start",
    "all_frames": true
  },
  {
    "matches": ["*://*.youtube.com/*", "*://youtube.com/*", "*://*.youtu.be/*", "*://youtu.be/*"],
    "css": ["youtube.css"],
    "js": ["content_isolated.js"],
    "run_at": "document_start",
    "all_frames": true
  },
  {
    "matches": ["<all_urls>"],
    "exclude_matches": [
      "*://*.google.com/*", "*://google.com/*",
      "*://*.google.co.uk/*", "*://google.co.uk/*",
      "*://*.google.com.au/*", "*://google.com.au/*",
      "*://*.google.ca/*", "*://google.ca/*",
      "*://*.google.de/*", "*://google.de/*",
      "*://*.google.fr/*", "*://google.fr/*"
    ],
    "js": ["blocker_logic.js"],
    "run_at": "document_start",
    "world": "MAIN",
    "all_frames": true
  }],
  "web_accessible_resources": [{
    "resources": ["blocker_logic.js", "blocked.html", "popup.css", "assets/*"],
    "matches": ["<all_urls>"]
  }]
}
