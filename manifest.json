{
  "manifest_version": 3,
  "name": "Cookie Crunch Blocker",
  "version": "9.9",
  "permissions": ["storage", "scripting", "declarativeNetRequest", "webNavigation", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "declarative_net_request": {
    "rule_resources": [{
      "id": "ruleset_1",
      "enabled": true,
      "path": "rules.json"
    }]
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "exclude_matches": ["*://*.youtube.com/*", "*://youtube.com/*", "*://*.youtu.be/*", "*://youtu.be/*"],
    "css": ["blocker.css"],
    "js": ["content_isolated.js"],
    "run_at": "document_start",
    "all_frames": true
  },
  {
    "matches": ["*://*.youtube.com/*", "*://youtube.com/*", "*://*.youtu.be/*", "*://youtu.be/*"],
    "css": ["youtube.css"],
    "js": ["content_isolated.js"],
    "run_at": "document_start",
    "all_frames": true
  },
  {
    "matches": ["<all_urls>"],
    "js": ["blocker_logic.js"],
    "run_at": "document_start",
    "world": "MAIN",
    "all_frames": true
  }],
  "web_accessible_resources": [{
    "resources": ["blocker_logic.js", "blocked.html"],
    "matches": ["<all_urls>"]
  }]
}
